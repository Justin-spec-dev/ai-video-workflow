APP_ENV=development

DATABASE_URL=sqlite+aiosqlite:///./data/app.db

OUTPUT_DIR=./outputs

# FFmpeg：默认自动查找（env → ./tools/ffmpeg/ → 系统 PATH）
FFMPEG_PATH=
FFPROBE_PATH=

MAX_CONCURRENCY=2

DEFAULT_RETRY_COUNT=3
DEFAULT_POLL_INTERVAL=10

# Credential 加密密钥（Fernet）。留空则首次启动自动生成并保存到 backend/data/.secret_key
CREDENTIAL_ENCRYPTION_KEY=

# 第三方 API Key 不需要写在这里——请使用 Web UI 的 Providers & Credentials 页面配置
